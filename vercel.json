{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",
  "ignoreCommand": "node scripts/vercel/ignore-build.mjs",
  "crons": [
    {
      "path": "/api/cron/expire-sessions",
      "schedule": "0 3 * * *"
    }
  ]
}
