# Server-only values. Copy this file to .env.local; never commit real credentials.
# Neon / Vercel Marketplace supplies these for each environment.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Preview-only safety check: the production URL's hostname, without credentials.
DATABASE_PRODUCTION_HOST=ep-example.region.aws.neon.tech

# Reserved for M5. Not used or required by the scaffold.
GEMINI_API_KEY=replace-with-your-server-side-key

# M2: bearer token Vercel Cron sends to GET /api/cron/expire-sessions.
# Set by Vercel when the cron job is configured; any other caller is 401.
CRON_SECRET=replace-with-a-long-random-value

# M6: Auth.js (Google only). No real credentials exist yet — with any of
# these unset, the app still builds and all tests pass, and the sign-in
# button shows "Sign-in unavailable" instead of a broken OAuth flow.
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GOOGLE_ID=replace-with-a-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-a-google-oauth-client-secret

# Hardening (pre-launch security review):

# M1: site-wide daily cap on real Gemini model calls, across every caller
# combined (separate from the existing per-IP limit). Must be a positive
# integer; unset or invalid falls back to the built-in default of 500 —
# see src/server/analysis/rate-limit-config.ts. Once hit, the analysis route
# serves the deterministic fallback (never a 429) until the next UTC day.
ANALYSIS_DAILY_MODEL_CAP=500

# L2: rate_limits.key stores an HMAC-SHA256 of the caller's IP (or other
# rate-limit identity), keyed on this secret, instead of the raw value.
# Unset falls back to a fixed, non-secret salt (still hashed, but reversible
# by brute force) and logs a warning once — set a long random value in
# every real environment.
RATE_LIMIT_KEY_SECRET=replace-with-a-long-random-value

# Build-time public flag (read by the client bundle, so it is fixed at
# `next build`, not at runtime). OFF when unset, which is what production
# uses. Set to 1 to show the "No paper? Use a ruler instead" typed-hand-length
# entry — only after the M2 photo check of its two gates (src/lib/flags.ts).
# NEXT_PUBLIC_TYPED_HAND_LENGTH_ENTRY=1

# Build-time public value (read by the client bundle, so it is fixed at
# `next build`, not at runtime): the PostHog project API key (US cloud). Set
# it only for Vercel Production. When unset, analytics is a no-op (local, CI,
# e2e and previews send nothing). Events go through the same-origin `/ingest`
# rewrite in next.config.ts (src/client/analytics/). Never commit a real key.
# NEXT_PUBLIC_POSTHOG_KEY=phc_replace-with-your-project-key
